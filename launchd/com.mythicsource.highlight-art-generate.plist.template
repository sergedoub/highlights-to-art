<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mythicsource.highlight-art-generate</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/.venv/bin/highlight-art</string>
    <string>--config</string><string>__PROJECT_ROOT__/config.toml</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT_ROOT__</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__PROJECT_ROOT__/var/generate.stdout.log</string>
  <key>StandardErrorPath</key><string>__PROJECT_ROOT__/var/generate.stderr.log</string>
</dict>
</plist>
